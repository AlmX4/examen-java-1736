        R1["Interfaces DAO<br/>JDBC puro con PreparedStatement"]
    end

    subgraph DB["MySQL 8"]
        direction TB
        D1[("20 tablas<br/>database/schema.sql")]
    end

    subgraph SUPPORT["paquetes de soporte"]
