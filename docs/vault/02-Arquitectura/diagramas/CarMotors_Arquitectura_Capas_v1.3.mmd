flowchart LR
    subgraph VIEW["view · com.carmotors.sgt.view"]
        direction TB
        V1["Menús de consola<br/>SubmenuVista · ConsoleReader"]
    end

    subgraph CONTROLLER["controller · com.carmotors.sgt.controller"]
